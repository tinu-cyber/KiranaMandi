[Unit]
Description=KiranaMandi web app
After=network.target

[Service]
User=kiranamandi
Group=kiranamandi
WorkingDirectory=/opt/kiranamandi
EnvironmentFile=/opt/kiranamandi/.env
ExecStart=/opt/kiranamandi/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 wsgi:app
Restart=on-failure

[Install]
WantedBy=multi-user.target
