# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
APP_NAME=KiranaMandi
BASE_URL=https://your-domain.example
COOKIE_SECURE=1
# 1 when running behind Caddy or nginx on the same server (real client IPs for rate limits)
TRUST_PROXY=1
PRO_PRICE_INR=399

# SQLite file. Defaults to instance/kiranamandi.sqlite
# DATABASE_PATH=/var/lib/kiranamandi/kiranamandi.sqlite

# Free key from https://data.gov.in (register, then "My Account"). Needed for `flask ingest`.
DATA_GOV_API_KEY=
# Resource id of the daily mandi price dataset on data.gov.in. Check it is current.
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
# data.gov.in blocks many non-Indian IPs. If this server is outside India, point this at an
# HTTP proxy in India, e.g. http://MUMBAI_PRIVATE_OR_PUBLIC_IP:8888 (see deploy/india-proxy.md)
DATA_GOV_PROXY=

# Email (leave SMTP_HOST empty to log messages instead of sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=KiranaMandi <alerts@your-domain.example>

# Telegram alerts (optional): create a bot with @BotFather
TELEGRAM_BOT_TOKEN=
